# Copy to .env and adjust. Everything here has a working development default,
# so `cp .env.example .env && docker compose up -d` is enough to get started.

# ---------------------------------------------------------------- ports
WEB_PORT=8080          # web UI:  http://localhost:8080
API_PORT=8000          # REST API + OpenAPI docs: http://localhost:8000/docs
MQTT_PORT=1883         # Pico W devices connect here
MQTT_WS_PORT=9001      # MQTT over WebSocket, for debugging tools only

# ----------------------------------------------------------------- MQTT
# Leave the credentials empty while the broker allows anonymous access.
# When you enable authentication (see README: Turning on authentication),
# fill these in and set the same values in the Pico's config.py.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=lego-backend
MQTT_KEEPALIVE=30

# ------------------------------------------------------------- database
# SQLite by default. To switch to PostgreSQL: add a `db` service, uncomment
# asyncpg in backend/requirements.txt and use, for example:
#   DATABASE_URL=postgresql+asyncpg://lego:secret@db:5432/lego
DATABASE_URL=sqlite+aiosqlite:////data/trains.db

# ------------------------------------------------------- safety & limits
MAX_SPEED=100                 # hard ceiling; each train may set a lower one
OFFLINE_TIMEOUT_SECONDS=20    # silence after which a train is marked "no signal"
HEARTBEAT_INTERVAL_SECONDS=2  # backend liveness beacon; must be well below the
                              # firmware's SAFETY_TIMEOUT_S (default 6s)

# ---------------------------------------------------------------- misc
LOG_LEVEL=INFO
CORS_ORIGINS=*                # the UI is same-origin via nginx; tighten if you
                              # serve the frontend from somewhere else

# ------------------------------------------------------------ simulator
SIM_COUNT=3                   # simulated trains: train-001 .. train-003
SIM_TELEMETRY_INTERVAL=2.0
SIM_SAFETY_TIMEOUT=6.0
